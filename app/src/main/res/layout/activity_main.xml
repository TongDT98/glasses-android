<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F4F8"
    android:fillViewport="true"
    tools:ignore="MissingClass">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- ╔══════════════════════════════════════════════════════╗ -->
        <!-- ║          DEVICE STATUS CARD                         ║ -->
        <!-- ╚══════════════════════════════════════════════════════╝ -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            xmlns:app="http://schemas.android.com/apk/res-auto">

            <!-- Dark gradient background -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_device_card"
                android:orientation="horizontal"
                android:padding="20dp"
                android:gravity="center_vertical">

                <!-- LEFT: device info -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <!-- Device name -->
                    <TextView
                        android:id="@+id/tv_device_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Chưa kết nối"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.02" />

                    <!-- Connection status badge -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/bg_status_badge"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp">

                        <!-- Status dot -->
                        <View
                            android:id="@+id/view_status_dot"
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:background="@drawable/ic_status_dot_disconnected"
                            android:layout_marginEnd="6dp" />

                        <TextView
                            android:id="@+id/tv_connection_status"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Không kết nối"
                            android:textColor="#8BAED4"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <!-- Battery row -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <!-- Battery icon -->
                        <TextView
                            android:id="@+id/tv_battery_icon"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🔋"
                            android:textSize="14sp"
                            android:layout_marginEnd="6dp" />

                        <!-- Battery bar background -->
                        <FrameLayout
                            android:layout_width="80dp"
                            android:layout_height="12dp"
                            android:layout_marginEnd="8dp">

                            <!-- Track -->
                            <View
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="#1A3060" />

                            <!-- Fill -->
                            <View
                                android:id="@+id/view_battery_fill"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:background="#00C853" />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/tv_battery_pct"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="–"
                            android:textColor="#8BAED4"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <!-- Action row: Scan / Reconnect / Disconnect -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btn_scan"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:text="Scan"
                            android:textSize="11sp"
                            android:textColor="#4A9EFF"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:minWidth="0dp"
                            android:minHeight="0dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp" />

                        <Button
                            android:id="@+id/btn_connect"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:layout_marginStart="8dp"
                            android:text="Kết nối"
                            android:textSize="11sp"
                            android:textColor="#4A9EFF"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:minWidth="0dp"
                            android:minHeight="0dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp" />

                        <Button
                            android:id="@+id/btn_disconnect"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:layout_marginStart="8dp"
                            android:text="Ngắt"
                            android:textSize="11sp"
                            android:textColor="#FF6B6B"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:minWidth="0dp"
                            android:minHeight="0dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- RIGHT: glasses illustration -->
                <ImageView
                    android:layout_width="110dp"
                    android:layout_height="80dp"
                    android:layout_marginStart="8dp"
                    android:src="@drawable/ic_glasses_device"
                    android:scaleType="fitCenter"
                    android:alpha="0.92"
                    android:contentDescription="Smart glasses" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ── VOICE AGENT ──────────────────────────────────────── -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp"
            android:text="VOICE AGENT"
            android:textColor="#7090B0"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.12" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_start_voice"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:backgroundTint="#1976D2"
                android:text="▶ Bắt đầu"
                android:textColor="#FFFFFF" />

            <Button
                android:id="@+id/btn_stop_voice"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:backgroundTint="#455A64"
                android:text="⏹ Dừng"
                android:textColor="#FFFFFF" />

            <!--<Button
                android:id="@+id/btn_test_speaker"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:backgroundTint="#37474F"
                android:text="🔊 Test"
                android:textColor="#FFFFFF" />-->
        </LinearLayout>

        <!-- Hidden websocket_url — vẫn giữ id để MainActivity không crash -->
        <EditText
            android:id="@+id/websocket_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:inputType="textUri"
            android:singleLine="true" />

        <!-- ── MEDIA CONTROLS ───────────────────────────────────── -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp"
            android:text="MEDIA"
            android:textColor="#7090B0"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.12" />

        <!-- 3 media buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <!-- Photo -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <Button
                    android:id="@+id/btn_take_photo"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:backgroundTint="#1565C0"
                    android:text="📷"
                    android:textSize="22sp"
                    android:padding="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="Chụp ảnh"
                    android:textSize="11sp"
                    android:textColor="#546E7A"
                    android:gravity="center" />
            </LinearLayout>

            <!-- Video -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <Button
                    android:id="@+id/btn_toggle_video"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:backgroundTint="#C62828"
                    android:text="🎥"
                    android:textSize="22sp"
                    android:padding="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp" />

                <TextView
                    android:id="@+id/tv_video_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="Quay video"
                    android:textSize="11sp"
                    android:textColor="#546E7A"
                    android:gravity="center" />
            </LinearLayout>

            <!-- Audio -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <Button
                    android:id="@+id/btn_toggle_audio"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:backgroundTint="#2E7D32"
                    android:text="🎙"
                    android:textSize="22sp"
                    android:padding="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp" />

                <TextView
                    android:id="@+id/tv_audio_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="Ghi âm"
                    android:textSize="11sp"
                    android:textColor="#546E7A"
                    android:gravity="center" />
            </LinearLayout>
        </LinearLayout>

        <!-- Sync row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_unsynced_count"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_chip"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:text="Không có file chờ đồng bộ"
                android:textSize="12sp"
                android:textColor="#455A64" />

            <Button
                android:id="@+id/btn_check_media"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:backgroundTint="#607D8B"
                android:text="Kiểm tra"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btn_sync_media"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:backgroundTint="#E65100"
                android:text="Đồng bộ"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btn_open_gallery"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:backgroundTint="#4527A0"
                android:text="📂"
                android:textSize="16sp"
                android:textColor="#FFFFFF"
                android:padding="8dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp" />
        </LinearLayout>

        <!-- Sync progress (hidden) -->
        <LinearLayout
            android:id="@+id/layout_sync_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/tv_sync_progress_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Đang đồng bộ…"
                android:textSize="12sp"
                android:textColor="#607D8B" />

            <ProgressBar
                android:id="@+id/progress_sync"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:max="100"
                android:progress="0" />
        </LinearLayout>

        <!-- ── STATUS LOG ───────────────────────────────────────── -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="6dp"
            android:text="LOG"
            android:textColor="#7090B0"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.12" />

        <TextView
            android:id="@+id/status_log"
            android:layout_width="match_parent"
            android:layout_height="240dp"
            android:background="#111827"
            android:fontFamily="monospace"
            android:gravity="bottom"
            android:padding="12dp"
            android:scrollbars="vertical"
            android:text="Ready."
            android:textColor="#94A3B8"
            android:textSize="11sp" />

    </LinearLayout>
</ScrollView>